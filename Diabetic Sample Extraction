        SUBSTRING(
            pc.data,
            CHARINDEX(
                'Value="',
                pc.data,
                CHARINDEX('<Cell Row="3" Col="5"', pc.data)
            ) + 7,
 
            CHARINDEX(
                '"',
                pc.data,
                CHARINDEX(
                    'Value="',
                    pc.data,
                    CHARINDEX('<Cell Row="3" Col="5"', pc.data)
                ) + 7
            )
            -
            (
                CHARINDEX(
                    'Value="',
                    pc.data,
                    CHARINDEX('<Cell Row="3" Col="5"', pc.data)
                ) + 7
            )
        ) AS [Column E Value]
 
    FROM dbo.patient_clinical_observation pc
 
    INNER JOIN dbo.patient_visit pv
        ON pc.patient_visit_id =
           pv.patient_visit_id
 
    LEFT JOIN dbo.patient_info_view piv
        ON pv.patient_id =
           piv.person_id
 
