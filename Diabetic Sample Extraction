        pv.patient_id,
        piv.visible_patient_id AS hn,
 
        LTRIM(RTRIM(
            COALESCE(piv.first_name_l, '') + ' ' +
            COALESCE(piv.middle_name_l + ' ', '') +
            COALESCE(piv.last_name_l, '')
        )) AS patient_name,
 
        pv.patient_visit_id,
        pv.actual_visit_date_time AS visit_date,
 
        pc.external_description AS [Template],
        coi.code AS [Medcin Code],
        coi.name_l AS [Observation],
 
        pcod.text_value,
        pcod.numeric_value,
        pcod.observation_date_time,
        pcod.comment
 
    FROM dbo.patient_clinical_observation_detail pcod
 
    INNER JOIN dbo.clinical_observation_item_ref_nl_view coi
        ON pcod.clinical_observation_item_rid =
           coi.clinical_observation_item_rid
 
    INNER JOIN dbo.patient_clinical_observation pc
        ON pcod.patient_clinical_observation_id =
           pc.patient_clinical_observation_id
 
    INNER JOIN dbo.patient_visit pv
        ON pc.patient_visit_id =
           pv.patient_visit_id
 
    LEFT JOIN dbo.patient_info_view piv
        ON pv.patient_id =
           piv.person_id
 
    WHERE coi.code = '30479'
 
      AND pc.external_description =
          'Patient Admission Database Part2 (Physician)'
 
      AND pcod.observation_date_time >= '2026-08-01'
 
      AND pcod.observation_date_time < '2026-08-16'
) adm
 
FULL OUTER JOIN
